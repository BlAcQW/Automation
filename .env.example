# Database - Supabase
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Redis (optional - only needed for job queues like reminders)
# Uncomment if you want to enable background job processing
# REDIS_URL="redis://localhost:6379"

# JWT Secrets (generate each with: openssl rand -base64 32)
# Must be at least 32 characters. ADMIN_JWT_SECRET must differ from JWT_SECRET
# so a tenant user cannot forge an admin token.
JWT_SECRET="your-jwt-secret-here-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-here-change-in-production"
ADMIN_JWT_SECRET="your-admin-jwt-secret-here-change-in-production"

# WhatsApp Cloud API
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"
# Redirect URI configured in your Meta App's Facebook Login product. Must
# exactly match what's set in App Dashboard → Facebook Login → Settings.
# This is where the user lands after the Embedded Signup popup completes.
WHATSAPP_REDIRECT_URI="http://localhost:3000/whatsapp"

# Encryption Key for storing tokens (generate with: openssl rand -base64 32)
ENCRYPTION_KEY="your-encryption-key-here-change-in-production"

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/google/callback"

# Outlook Calendar OAuth (optional)
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_REDIRECT_URI="http://localhost:3001/api/calendar/outlook/callback"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Feature flags. PRODUCT mode (product/order/inventory dashboard, product
# bot flow, product signup option) is parked until the SERVICE side is
# proven in production. Set BOTH to "true" to re-enable PRODUCT mode.
ENABLE_PRODUCT_MODE="false"
NEXT_PUBLIC_ENABLE_PRODUCT_MODE="false"

# API Server
API_PORT=3001
API_HOST="0.0.0.0"

# Frontend Server
WEB_PORT=3000

# Observability (optional — Sentry SDKs no-op when unset)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Paystack — the customer is redirected after paying to
# ${FRONTEND_URL}/pay/order or ${FRONTEND_URL}/pay/booking (derived
# automatically from FRONTEND_URL — no separate var needed).
# Tenant-level Paystack keys are pasted in Settings, not here.

# BookingFlow platform Paystack (Phase 4b — SaaS subscriptions).
# Separate from the per-tenant keys in Settings: these belong to BookingFlow
# itself and are used to bill tenants for the SaaS subscription.
BOOKINGFLOW_PAYSTACK_SECRET_KEY=""
BOOKINGFLOW_PAYSTACK_PUBLIC_KEY=""

# Paystack plan codes — create these plans in your Paystack dashboard at the
# monthly amounts matching services/plans.ts, then paste the resulting
# PLN_xxx codes here. Free has no Paystack plan (it's not charged).
PAYSTACK_PLAN_STARTER_CODE=""
PAYSTACK_PLAN_PRO_CODE=""

# Platform-level SMTP fallback (Phase 5a — used when the tenant hasn't
# connected their own Gmail in Settings).
#
# For Gmail: generate the 16-char app password at
#   https://myaccount.google.com/apppasswords
# When unset, the platform fallback is inert; only per-tenant Gmail is used.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="BookingFlow"

# Legacy aliases — same values, accepted for backward compat with earlier
# documentation. SMTP_* takes precedence when both are set.
BOOKINGFLOW_GMAIL_USER=""
BOOKINGFLOW_GMAIL_APP_PASSWORD=""
BOOKINGFLOW_GMAIL_FROM_NAME=""
