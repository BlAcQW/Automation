apps/api/var/

# Deploy backups and swap folders made when a new build is put live. Build
# output, hundreds of MB each: never commit.
apps/api/dist.prev-*/
apps/api/dist.next/
apps/web/.next.pre-*/
apps/web/.next.next/

# Per-session cache written by the impeccable design hook.
.impeccable/hook.cache.json
