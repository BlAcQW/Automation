// Prisma Schema for BookingFlow
// Multi-tenant WhatsApp Booking Automation Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT & USER MANAGEMENT
// ============================================

model Tenant {
  id                          String              @id @default(cuid())
  name                        String
  // Sub-type WITHIN the APPOINTMENTS vertical (service vs product catalog).
  businessType                BusinessType        @default(SERVICE)
  // Which product shape this tenant runs. See services/verticals.ts for the
  // per-vertical Tenant defaults.
  vertical                    Vertical            @default(APPOINTMENTS)
  // When set, replaces the plan's monthlyMessageQuota for this tenant.
  // NULL = plan default. Never negative (validated at the API boundary).
  monthlyMessageQuotaOverride Int?
  timezone                    String              @default("UTC")
  whatsappPhoneNumberId       String?             @unique
  whatsappAccountId           String?
  whatsappAccessToken         String? // Encrypted. NULL for hosted numbers — they use the platform token.
  whatsappDisplayNumber       String?
  // Phase 6 — Bookly-hosted numbers. TRUE means this number lives on Bookly's
  // OWN WABA, so Meta bills Bookly for it and Bookly rebills the tenant. FALSE
  // (the default) is the bring-your-own path via Embedded Signup, where the
  // tenant owns the WABA and pays Meta directly.
  whatsappHosted              Boolean             @default(false)
  // Onboarding progress for hosted numbers only: PENDING_CODE (added to our
  // WABA, OTP sent) → REGISTERED (verified + registered for Cloud API).
  // NULL for bring-your-own numbers, which are live the moment they connect.
  whatsappNumberStatus        String?
  // Encrypted. Hosted numbers only — Meta's two-step verification PIN, set when
  // we register the number. Meta requires a re-register (with this same PIN)
  // after any display-name change, so it has to outlive onboarding.
  whatsappRegistrationPin     String?
  paystackSecretKey           String? // Encrypted (AES-GCM via crypto.ts)
  paystackPublicKey           String? // Public, plaintext OK
  paymentCurrency             String              @default("NGN") // ISO 4217
  // Phase 4a — SaaS plan id. Kept as String so the catalog (services/plans.ts)
  // can grow without a migration. Validated against the catalog at the API boundary.
  planId                      String              @default("free")
  // Phase 4b — Paystack subscription state. Null for tenants that predate 4b.
  subscriptionStatus          SubscriptionStatus?
  subscriptionRef             String? // Paystack subscription_code (SUB_xxx)
  subscriptionEmailToken      String? // Paystack-issued token, required to disable
  subscriptionCustomerCode    String? // Paystack customer_code (CUS_xxx)
  currentPeriodEnd            DateTime?
  trialEndsAt                 DateTime?
  // Phase 4c — per-tenant 30-day quota cycle anchor. Decouples quota refresh
  // from the calendar 1st: each tenant gets 5,000 messages every 30 days
  // counted from their signup, not from the start of the calendar month
  // (which double-counts mid-month subscribers). Nullable for back-compat —
  // null falls back to `createdAt` so legacy tenants behave the same.
  quotaCycleStart             DateTime?
  // Phase 5 — SMS fallback (Arkesel) + Email fallback (Gmail SMTP).
  arkeselApiKey               String? // Encrypted at rest via crypto.ts
  arkeselSenderId             String? // 1-11 chars, alphanumeric or phone
  gmailUser                   String? // Tenant's Gmail address
  gmailAppPassword            String? // 16-char app password, encrypted
  gmailFromName               String? // Display name in From: header
  // Master switch — when false, the worker skips all out-of-window messages
  // (BOOKING_REMINDER, ORDER_SHIPPED, ORDER_DELIVERED) to save messaging cost.
  outOfWindowMessagesEnabled  Boolean             @default(true)
  // Deposits. When on, a booking is only confirmed once the customer has paid
  // the deposit; until then it is held for a short window. Per-service
  // `Service.depositAmount` overrides the default when it is set.
  depositRequired             Boolean             @default(true)
  defaultDepositAmount        Decimal             @default(50) @db.Decimal(10, 2)
  // How many bookings the business can serve at the same time — chairs in a
  // salon, rooms in a clinic, bays in a workshop. Availability and booking
  // creation both allow up to this many overlapping bookings. Default 1 keeps
  // the old single-resource behaviour for every existing tenant.
  bookingCapacity             Int                 @default(1)
  // Hide most of each customer's phone/email from STAFF in the dashboard, so
  // a departing staff member cannot walk off with the customer book. The owner
  // is never masked. Staff who genuinely need a number use the audited,
  // rate-limited reveal endpoint.
  maskCustomerContact         Boolean             @default(true)
  // Facebook Page + Instagram. One Page access token serves both, because
  // Instagram messaging is delivered through the Page the IG professional
  // account is linked to. Unlike WhatsApp, Meta charges nothing per message on
  // either channel and needs no payment method.
  facebookPageId              String?             @unique
  facebookPageName            String?
  facebookPageToken           String? // Encrypted
  instagramUserId             String?             @unique
  instagramUsername           String?
  // The owner asked for the account to be deleted. A person confirms and
  // removes the tenant; this records the ask and shows it in Settings.
  deletionRequestedAt         DateTime?
  // Who answers this tenant's conversations. NULL = the vertical's default.
  // 'llm' | 'flow' | 'external'. A String, not an enum, so a new handler kind
  // needs no migration; validated against the known set at the API boundary.
  conversationMode            String?
  // The FlowDefinition.key a 'flow' tenant runs. Ignored for other modes.
  activeFlowKey               String?
  isActive                    Boolean             @default(true)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  users                User[]
  services             Service[]
  bookings             Booking[]
  products             Product[]
  orders               Order[]
  conversations        Conversation[]
  workingHours         WorkingHours[]
  blackoutDates        BlackoutDate[]
  calendarIntegrations CalendarIntegration[]
  notifications        Notification[]
  messageTemplates     MessageTemplate[]
  tenantUsages         TenantUsage[]
  promoRedemptions     PromoRedemption[]
  customers            Customer[]
  wallet               Wallet?
  externalApp          ExternalApp?
  apiKeys              ApiKey[]
  domainEvents         DomainEvent[]
  webhookSubscriptions WebhookSubscription[]

  @@index([whatsappPhoneNumberId])
  @@index([businessType])
}

enum Vertical {
  APPOINTMENTS
  RIDES
}

enum BusinessType {
  PRODUCT
  SERVICE
}

model User {
  id              String    @id @default(cuid())
  tenantId        String
  email           String
  passwordHash    String
  name            String
  role            Role      @default(STAFF)
  isActive        Boolean   @default(true)
  // When they ticked "I agree" at sign-up. Null for accounts created before
  // the checkbox existed.
  termsAcceptedAt DateTime?
  // Set by the link in the verification email. Null = unverified; the
  // dashboard nags, nothing is blocked.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceTokens DeviceToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// DeviceToken — a mobile device's push token (Expo push token, or FCM/APNs).
// Registered by the mobile app after the user grants notification permission,
// and used to fan out push notifications to a tenant's owners/staff when an
// in-app Notification is created (new booking, cancellation, new conversation).
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String // denormalised for cheap tenant-wide fan-out
  token      String   @unique // Expo push token (ExponentPushToken[...]) or native token
  platform   String // 'ios' | 'android'
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

enum Role {
  OWNER
  STAFF
}

// Platform Admin - separate from tenants, can manage all data
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  isSuperAdmin Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  promoCodes PromoCode[]

  @@index([email])
}

// ============================================
// PROMO CODES (platform-level, created by admins)
// ============================================

enum PromoKind {
  TRIAL_EXTENSION // adds `days` of trial on the tenant's current (or Pro) plan
  PLAN_GRANT // puts the tenant on `planId` for `days`, no card needed
}

model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique // stored upper-case, no spaces
  kind             PromoKind
  days             Int
  planId           String? // PLAN_GRANT only
  description      String? // internal note: campaign, who it was for
  maxRedemptions   Int? // null = unlimited
  redemptionCount  Int       @default(0)
  expiresAt        DateTime? // null = never
  isActive         Boolean   @default(true)
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdBy   Admin?            @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  redemptions PromoRedemption[]

  @@index([isActive])
}

model PromoRedemption {
  id          String   @id @default(cuid())
  promoCodeId String
  tenantId    String
  redeemedAt  DateTime @default(now())
  // What the code did, for the audit trail: previous plan, new trial end.
  effect      Json?

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, tenantId])
  @@index([tenantId])
}

// ============================================
// SERVICE MANAGEMENT
// ============================================

model Service {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  category        String?
  depositAmount   Decimal? @db.Decimal(10, 2) // null = no deposit required
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ============================================
// AVAILABILITY MANAGEMENT
// ============================================

model WorkingHours {
  id        String  @id @default(cuid())
  tenantId  String
  dayOfWeek Int // 0=Sunday, 6=Saturday
  startTime String // "09:00" (24hr format)
  endTime   String // "17:00" (24hr format)
  isActive  Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model BlackoutDate {
  id       String   @id @default(cuid())
  tenantId String
  date     DateTime @db.Date
  reason   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
}

// ============================================
// BOOKING MANAGEMENT
// ============================================

model Booking {
  id                      String        @id @default(cuid())
  tenantId                String
  serviceId               String
  customerName            String
  customerPhone           String
  customerEmail           String? // Phase 5: enables email fallback when present
  startTime               DateTime
  endTime                 DateTime
  status                  BookingStatus @default(CONFIRMED)
  bookingReference        String        @unique
  calendarEventId         String?
  notes                   String?
  // Phase 3d — deposit / Paystack payment fields. Mirror Order's shape.
  paymentStatus           PaymentStatus @default(UNPAID)
  paymentReference        String?       @unique
  paymentAuthorizationUrl String?
  /// Which Paystack account this payment was created on, recorded SERVER-SIDE
  /// when the link was made. Never inferred from the reference or from
  /// provider metadata: a tenant who connects their own key controls both, and
  /// could otherwise mint a payment in their own account and have it credited
  /// against Bookly's balance.
  collectionRoute         String?
  /// Lifecycle of the deposit money, separate from the booking's own status.
  /// NULL = still held. Advanced by an ATOMIC conditional update before any
  /// provider call, so a clearing and a refund cannot both act on the same
  /// deposit — one of them loses the claim and stops.
  depositState            String?
  paidAt                  DateTime?
  depositAmount           Decimal?      @db.Decimal(10, 2) // snapshot at booking time
  publicToken             String?       @unique // non-guessable token for the SMS cancel link
  // Link to the Customer record. SetNull: the booking is a financial record
  // and survives customer deletion (it keeps its own name/phone snapshot).
  customerId              String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([tenantId])
  @@index([tenantId, startTime])
  @@index([customerPhone])
  @@index([bookingReference])
  @@index([paymentReference])
}

enum BookingStatus {
  PENDING_PAYMENT // Slot held; awaiting Paystack deposit
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ============================================
// WHATSAPP CONVERSATIONS
// ============================================

model Conversation {
  id              String              @id @default(cuid())
  tenantId        String
  // Which inbox this conversation lives in. WhatsApp is the default so every
  // existing row keeps its meaning without a backfill decision.
  channel         ConversationChannel @default(WHATSAPP)
  // The customer's id ON THAT CHANNEL: the phone number for WhatsApp, an
  // Instagram-scoped id (IGSID) or a Page-scoped id (PSID) otherwise. This,
  // not the phone, is what identifies a conversation now.
  externalId      String
  // Nullable since Instagram and Messenger give us no phone number. A booking
  // still needs one, so the bot asks for it on those channels — which it has
  // to anyway, because reminders there can only go out over SMS.
  customerPhone   String?
  // @username, Instagram only. Display aid; never an addressing key.
  customerHandle  String?
  customerName    String?
  state           ConversationState   @default(BOT_ACTIVE)
  botContext      Json? // Current bot flow state
  assignedUserId  String? // Staff member assigned to this conversation
  assignedAt      DateTime? // When the conversation was assigned
  takeoverReason  String? // Reason for human takeover
  /// When the conversation was handed to a human (orders the staff queue).
  takeoverAt      DateTime?
  botFailureCount Int                 @default(0) // Count of bot failures for auto-takeover
  // The end customer this conversation is with, once resolved. SetNull: the
  // conversation history outlives a deleted customer record.
  customerId      String?
  contextVersion  Int                 @default(0) // Optimistic-lock counter — incremented on every botContext write; concurrent updates that read a stale version are dropped
  lastInboundAt   DateTime? // Timestamp of last customer message — drives the WhatsApp 24-hour customer-service window check
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([tenantId, channel, externalId])
  @@index([customerId])
  @@index([tenantId])
  @@index([customerPhone])
  @@index([tenantId, lastInboundAt])
  @@index([tenantId, channel])
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
  MESSENGER
}

enum ConversationState {
  BOT_ACTIVE
  HUMAN_ACTIVE
}

model Message {
  id              String         @id @default(cuid())
  conversationId  String
  direction       Direction
  content         String
  messageType     MessageType    @default(TEXT)
  whatsappMsgId   String?
  metadata        Json?
  /// Delivery state for OUTBOUND messages (null until the first status webhook).
  status          MessageStatus?
  /// What Meta actually billed this message as — "service", "utility",
  /// "marketing", "authentication". Taken from the status webhook's pricing
  /// object rather than guessed, so billing mirrors Meta's own ledger.
  billingCategory String?
  /// False for messages inside a free allowance or free entry-point window.
  billable        Boolean?
  /// INBOUND only: set once the turn for this message completed normally
  /// (including deliberate no-reply outcomes). Null = stored but not yet
  /// answered, so a retry must run the turn instead of deduping it away.
  handledAt       DateTime?
  /// OUTBOUND agent replies only (outbox): the INBOUND message this answers.
  /// Plain id, no FK: it is only ever looked up, never joined.
  replyToId       String?
  /// OUTBOUND agent replies only: PENDING (stored, send not confirmed),
  /// SENT, or SUPPRESSED (quota / no channel: deliberately not sent). Null for
  /// every other message. Separate from `status`, which is Meta's delivery
  /// receipt and only exists after a successful send.
  sendState       String?
  /// When the current sender claimed this reply (sendState SENDING). A claim
  /// older than SEND_CLAIM_STALE_MS is presumed abandoned and may be taken over.
  sendClaimedAt   DateTime?
  createdAt       DateTime       @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Meta retries webhooks, so the same inbound wamid can arrive more than
  /// once. This makes a second insert fail with P2002 instead of storing (and
  /// replying to) a duplicate. whatsappMsgId is nullable: Postgres treats NULLs
  /// as distinct in a unique index (default NULLS DISTINCT), so rows with a
  /// null id (outbound rows before the send returns, SMS/email) never collide.
  /// Index name: Message_conversationId_whatsappMsgId_key.
  @@unique([conversationId, whatsappMsgId])
  @@index([conversationId])
  @@index([createdAt])
  @@index([replyToId])
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  INTERACTIVE
  TEMPLATE
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  STICKER
  LOCATION
  CONTACT
  REACTION
}

/// Delivery state reported by Meta's message-status webhook.
enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ============================================
// CALENDAR INTEGRATIONS
// ============================================

model CalendarIntegration {
  id           String           @id @default(cuid())
  tenantId     String
  provider     CalendarProvider
  accessToken  String // Encrypted
  refreshToken String? // Encrypted
  expiresAt    DateTime?
  calendarId   String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

// ============================================
// CACHED CALENDAR EVENTS (for availability)
// ============================================

model CalendarEvent {
  id                    String   @id @default(cuid())
  calendarIntegrationId String
  externalEventId       String
  title                 String?
  startTime             DateTime
  endTime               DateTime
  isAllDay              Boolean  @default(false)
  syncedAt              DateTime @default(now())

  @@unique([calendarIntegrationId, externalEventId])
  @@index([calendarIntegrationId])
  @@index([startTime, endTime])
}

// ============================================
// PRODUCT MANAGEMENT (for PRODUCT businesses)
// ============================================

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  imageUrl    String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ============================================
// ORDER MANAGEMENT (for PRODUCT businesses)
// ============================================

model Order {
  id                      String        @id @default(cuid())
  tenantId                String
  orderRef                String        @unique
  customerName            String
  customerPhone           String
  customerEmail           String? // Phase 5: enables email fallback when present
  totalAmount             Decimal       @db.Decimal(10, 2)
  status                  OrderStatus   @default(PENDING)
  paymentStatus           PaymentStatus @default(UNPAID)
  /// Which Paystack account this payment was created on, recorded SERVER-SIDE
  /// when the link was made. Never inferred from the reference or from
  /// provider metadata: a tenant who connects their own key controls both, and
  /// could otherwise mint a payment in their own account and have it credited
  /// against Bookly's balance.
  collectionRoute         String?
  /// See Booking.depositState.
  depositState            String?
  paymentReference        String?       @unique // Paystack tx reference
  paymentAuthorizationUrl String? // Paystack hosted-page URL
  paidAt                  DateTime?
  deliveryAddress         String?
  notes                   String?
  publicToken             String?       @unique // non-guessable token for the order tracking link
  // Link to the Customer record. SetNull: the order keeps its own snapshot.
  customerId              String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([customerId])
  @@index([tenantId])
  @@index([orderRef])
  @@index([customerPhone])
  @@index([status])
  @@index([paymentReference])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// ============================================
// IN-APP NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json? // e.g. { bookingId, conversationId }
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isRead])
  @@index([tenantId, createdAt])
}

enum NotificationType {
  NEW_BOOKING
  BOOKING_CANCELLED
  NEW_CONVERSATION
  SYSTEM
}

// ============================================
// WHATSAPP MESSAGE TEMPLATES
// ============================================
//
// Per-tenant registry of WhatsApp Cloud API templates that the tenant has
// registered (and Meta has approved) in their Business Manager. The
// notification worker maps internal NotificationType -> MessageTemplate.purpose
// and sends `type: 'template'` messages with positional body variables.
//
// Expected variable order per purpose (the tenant must design their template
// body to match):
//   BOOKING_CONFIRMATION  -> [customerName, serviceName, date, time, bookingRef]
//   BOOKING_REMINDER      -> [serviceName, time]
//   BOOKING_CANCELLED     -> [serviceName, date]
//   BOOKING_RESCHEDULED   -> [serviceName, newDate, newTime]
//   ORDER_CONFIRMATION    -> [orderRef, total]
//   ORDER_SHIPPED         -> [orderRef]
//   ORDER_DELIVERED       -> [orderRef]
//
model MessageTemplate {
  id            String           @id @default(cuid())
  tenantId      String
  name          String // Exact Meta template name (e.g. "booking_confirmation_v1")
  language      String           @default("en_US")
  category      TemplateCategory
  purpose       TemplatePurpose
  bodyPreview   String? // Human preview for the dashboard
  variableCount Int              @default(0)
  isApproved    Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, language])
  @@unique([tenantId, purpose])
  @@index([tenantId])
}

enum TemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

enum TemplatePurpose {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  ORDER_CONFIRMATION
  ORDER_SHIPPED
  ORDER_DELIVERED
}

// ============================================
// AUDIT LOG (Phase 2D)
// ============================================
//
// Append-only audit trail of security-relevant events. Used for compliance
// reporting and post-incident forensics. Not joined to Tenant via FK so that
// tenant deletion does not erase the audit history of what was done before.
//
model AuditLog {
  id         String    @id @default(cuid())
  tenantId   String? // null for platform-admin and system actions
  actorType  ActorType
  actorId    String? // userId, adminId, etc.
  action     String // e.g. "auth.login.success", "tenant.updated"
  targetType String? // e.g. "Booking", "Tenant"
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}

enum ActorType {
  USER
  ADMIN
  BOT
  SYSTEM
}

// Phase 4b — SaaS subscription lifecycle.
//   TRIALING : new tenant, 14-day Pro trial, no charge yet.
//   ACTIVE   : Paystack subscription is paying on schedule.
//   PAST_DUE : last charge failed; plan still resolves until currentPeriodEnd.
//   CANCELLED: explicitly cancelled or expired; lazy evaluator drops planId to free.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

// ============================================
// SAAS PLAN USAGE (Phase 4a)
// ============================================
//
// One row per tenant per month, holding the count of outbound WhatsApp
// messages the tenant has consumed against their plan quota. Counter is
// updated atomically via upsert so concurrent sends are safe.
//
model TenantUsage {
  id               String   @id @default(cuid())
  tenantId         String
  month            String // "YYYY-MM" UTC. Tenant-tz rollover is a Phase 8 polish.
  messageCount     Int      @default(0)
  /// SMS sent on BOOKLY's Arkesel account this cycle. Counted separately from
  /// messageCount because it is Bookly's money, not the tenant's allowance —
  /// without a per-tenant cap one busy tenant spends the whole budget.
  platformSmsCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
  @@index([tenantId])
}

// ============================================
// MONEY: WALLET, LEDGER, PAYOUTS
// ============================================
//
// Customers pay into BOOKLY's Paystack account, not the tenant's, so a salon
// owner never has to create a payment gateway account or paste an API key.
// What they earn is credited to a wallet here and paid out to their Mobile
// Money on request.
//
// The rule this schema exists to enforce: a balance is never a number anyone
// edits. It is the sum of an append-only ledger. `Wallet` carries cached
// figures for fast reads only, and a reconciliation job proves they still
// equal the ledger.
//
// Amounts are INTEGER MINOR UNITS (pesewas) everywhere. Floats lose money to
// rounding, and the loss is unrecoverable because nobody can say when it
// happened.

/// Accounts answer ONE question: who owns this money right now. They do not
/// also track where it physically sits — mixing the two needs two-dimensional
/// accounting and is how sign errors creep into a ledger.
///
/// Every movement sums to zero across these, so money is only ever moved and
/// never created. EXTERNAL is the world outside Bookly (the customer's card,
/// the tenant's MoMo wallet), which is what lets an inbound payment balance.
enum LedgerAccount {
  EXTERNAL // outside the system: money paid in, payouts leaving
  TENANT_PENDING // theirs, still clearing (deposit before the appointment)
  TENANT_AVAILABLE // theirs, withdrawable now
  PAYOUT_PENDING // theirs, committed to a payout in flight
  PLATFORM_FEE // Bookly's revenue
}

enum LedgerReason {
  DEPOSIT_RECEIVED // customer paid; credited to the tenant as pending
  FUNDS_CLEARED // pending -> available once the appointment has passed
  REFUND_ISSUED // money returned to the customer
  PAYOUT_REQUESTED // available -> payout pending
  PAYOUT_SETTLED // payout confirmed sent by the provider
  PAYOUT_REVERSED // payout failed; money returned to available
  PLATFORM_FEE_TAKEN // Bookly's cut
  ADJUSTMENT // manual correction; always audited, never routine
}

/// One wallet per tenant. Cached balances are an optimisation, NOT the truth.
model Wallet {
  id       String @id @default(cuid())
  tenantId String @unique
  currency String @default("GHS")

  /// Cached sums of the ledger, in minor units. Reconciled, never trusted for
  /// a debit — a withdrawal re-derives the balance inside its transaction.
  cachedAvailableMinor Int       @default(0)
  cachedPendingMinor   Int       @default(0)
  lastReconciledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payouts PayoutRequest[]
  entries LedgerEntry[]
}

/// One movement = one economic event, written as two or more entries that sum
/// to zero. `idempotencyKey` is UNIQUE, which is what makes a replayed webhook
/// or a double-tapped button a no-op at the database level rather than in an
/// `if` statement that can lose a race.
model LedgerMovement {
  id             String       @id @default(cuid())
  tenantId       String
  reason         LedgerReason
  idempotencyKey String       @unique
  currency       String       @default("GHS")

  bookingId String?
  orderId   String?
  payoutId  String?
  /// Set only for ADJUSTMENT, naming the admin who made it.
  note      String?

  createdAt DateTime @default(now())

  entries LedgerEntry[]

  @@index([tenantId, createdAt])
}

/// A single signed posting. Immutable: there is no update path, and a mistake
/// is corrected by writing a reversing movement, never by editing history.
model LedgerEntry {
  id          String        @id @default(cuid())
  movementId  String
  walletId    String
  tenantId    String
  account     LedgerAccount
  /// Signed, in minor units. Credits positive, debits negative.
  amountMinor Int
  currency    String        @default("GHS")
  createdAt   DateTime      @default(now())

  movement LedgerMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  wallet   Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([tenantId, account])
  @@index([movementId])
}

enum PayoutStatus {
  REQUESTED // money moved out of available, not yet sent
  PROCESSING // handed to the provider
  PAID
  FAILED
  CANCELLED
}

/// Where a tenant's money goes. Changing this is the classic account-takeover
/// move, so a new destination cannot receive funds until `usableFrom` passes.
model PayoutRecipient {
  id       String @id @default(cuid())
  tenantId String

  /// 'mobile_money' or 'bank'
  type                String
  /// Name on the account, as the provider resolved it — shown back to the
  /// owner so they can recognise it without decoding anything.
  accountName         String
  /// Encrypted. Never logged, never returned whole to a client.
  accountNumberEnc    String
  /// For display: "024 ••• 4567".
  accountNumberMasked String
  /// Telco code (MTN, VOD, ATL) or bank code.
  bankCode            String

  /// Paystack recipient_code once created.
  providerCode String?

  /// Cooling-off. A freshly added destination cannot be paid to before this.
  usableFrom DateTime
  isDefault  Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payouts PayoutRequest[]

  @@index([tenantId])
}

model PayoutRequest {
  id       String @id @default(cuid())
  tenantId String
  walletId String

  amountMinor Int
  currency    String       @default("GHS")
  status      PayoutStatus @default(REQUESTED)

  recipientId   String
  /// Paystack transfer_code / reference.
  providerRef   String? @unique
  /// Plain-language reason shown to the owner when it fails.
  failureReason String?

  /// Owners only — staff must never move money out.
  requestedByUserId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  settledAt DateTime?

  wallet    Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  recipient PayoutRecipient @relation(fields: [recipientId], references: [id])

  @@index([tenantId, status])
}

/// A tenant's end customer, keyed by phone. Linked (optional, SetNull) from
/// Conversation, Booking and Order.
model Customer {
  id         String   @id @default(cuid())
  tenantId   String
  /// E.164, e.g. +233241234567
  phone      String
  name       String?
  email      String?
  /// Vertical-specific fields with no column of their own, e.g. for RIDES
  /// { "studentId": "...", "university": "..." }. Free-form JSON: validate the
  /// shape per vertical at the API boundary, never trust it on read.
  attributes Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  bookings      Booking[]
  orders        Order[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

// Durable store for raw inbound webhooks (platform-level, no tenantId).
// Exists because acking the provider before processing lost messages when the
// process crashed or was redeployed mid-handling: the provider considered the
// delivery done and never retried. We persist first, ack, then process.
model WebhookInbox {
  id            String    @id @default(cuid())
  source        String // e.g. "META"
  payload       Json
  status        String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  attempts      Int       @default(0)
  lastError     String?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  /// Set when a worker claims the row. Stuck-PROCESSING detection measures from
  /// here, not receivedAt, so a slow-but-live turn is not mistaken for a crash.
  claimedAt     DateTime?
  /// Earliest time the sweep may re-dispatch a PENDING row (retry backoff).
  nextAttemptAt DateTime?

  @@index([status, receivedAt])
  @@index([status, nextAttemptAt])
  @@index([status, claimedAt])
}

// Things a human must look at. tenantId is null for platform-wide alerts.
// Deliberately NO FK to Tenant: alerts survive tenant removal (like AuditLog).
// Repeats of the same condition upsert on dedupeKey and bump count.
model PlatformAlert {
  id          String    @id @default(cuid())
  tenantId    String?
  kind        String
  severity    String // info | warning | critical
  message     String
  context     Json?
  dedupeKey   String    @unique
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([resolvedAt, severity, lastSeenAt])
  @@index([tenantId])
}

// ============================================
// WAVE 2: WORKFLOWS, EXTERNAL APPS, PUBLIC API, EVENTS
// ============================================

// Workflow definitions as data (D1), so a flow can be edited and versioned
// without a deploy. tenantId NULL = a vertical-level default that any tenant of
// that vertical falls back to. Deliberately NO FK to Tenant: defaults have no
// tenant. Because tenantId is nullable (like AuditLog) the model is in
// TENANT_SCOPED_MODELS; default rows (tenantId null) are only read WITHOUT
// tenant context (webhook, worker, admin).
// A version is immutable once published: change a flow by inserting version+1.
model FlowDefinition {
  id         String    @id @default(cuid())
  tenantId   String?
  vertical   Vertical?
  key        String
  version    Int
  definition Json
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  createdBy  String?

  // Postgres treats NULLs as distinct, so this does not stop two default rows
  // with the same (key, version); the app must enforce that for tenantId NULL.
  @@unique([tenantId, key, version])
  @@index([tenantId, key, isActive])
  @@index([vertical, key])
}

// An app hosted elsewhere that handles a tenant's conversations (D2). One per
// tenant. Inbound messages are POSTed to `url`, signed with the secret.
model ExternalApp {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  name             String
  /// Inbound delivery endpoint.
  url              String
  /// Encrypted at rest by application code (crypto.ts). Never returned to a client.
  signingSecretEnc String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Scoped keys for the public API (D2). Only a hash of the secret is stored; the
// raw key is shown once at creation. `prefix` is the public identifier used to
// look the key up before the hash is compared.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  prefix     String    @unique
  secretHash String
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Append-only record of things that happened (D3): the source for outgoing
// webhooks and any future timeline. Events are tenant data, so unlike AuditLog
// they cascade with the Tenant: removing a tenant must remove everything about
// it, and a surviving event would keep customer payloads with no owner. Audit
// history that must outlive the tenant belongs in AuditLog, not here.
model DomainEvent {
  id        String   @id @default(cuid())
  tenantId  String
  type      String // e.g. message.received, payment.succeeded
  payload   Json
  // Idempotency key (publishEventOnce): `${type}:${field}:${value}`. NULL for
  // ordinary events (Postgres treats NULLs as distinct in a unique index).
  dedupeKey String?
  createdAt DateTime @default(now())

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, createdAt])
  @@index([type, createdAt])
}

// A tenant's subscription to outgoing webhooks (D3).
model WebhookSubscription {
  id          String   @id @default(cuid())
  tenantId    String
  url         String
  events      String[] // event types, or a wildcard the app understands
  /// Encrypted at rest by application code; used to sign deliveries.
  secretEnc   String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
}

// One attempt-tracked delivery of one event to one subscription (D3). The
// unique pair makes fan-out idempotent. tenantId is denormalised (no FK of its
// own): the row is removed with its subscription/event when the tenant goes.
// claimedAt/nextAttemptAt mirror WebhookInbox for crash-safe claiming and
// retry backoff.
model WebhookDelivery {
  id             String    @id @default(cuid())
  tenantId       String
  subscriptionId String
  eventId        String
  status         String    @default("PENDING") // PENDING | SUCCEEDED | FAILED
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  claimedAt      DateTime?
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event        DomainEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([status, claimedAt])
  @@index([tenantId])
  @@index([eventId])
}
