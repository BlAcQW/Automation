{
    "compilerOptions": {
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@bookingflow/ui": ["../../packages/ui/src/index.ts"],
            "@bookingflow/ui/tailwind-preset": ["../../packages/ui/src/tailwind-preset.ts"],
            "@bookingflow/api-client": ["../../packages/api-client/src/index.ts"],
            "@bookingflow/auth-client": ["../../packages/auth-client/src/index.tsx"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}